# Copy to .env (gitignored) and fill in. Placeholders only: the repo is public.

# Postgres password for the `edgeflow` user. Required by docker-compose.yml, which builds the
# containers' DATABASE_URL from it. Keep it URL-safe; generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Only for running the backend outside Docker (compose overrides it inside the containers).
DATABASE_URL=postgresql+asyncpg://edgeflow:change-me@localhost:5432/edgeflow

# Signs and verifies HS256 login tokens. Required by docker-compose.yml. Generate one with:
# openssl rand -hex 32
JWT_HS256_SECRET=change-me

# Server only: the password gate (docs/deploy.md § Password gate). SITE_ADDRESS is the bare host
# name the site is served on (no http://). The login itself is set with scripts/gate-user.sh.
# COMPOSE_PROFILES=gate
# SITE_ADDRESS=app.example.com

FINNHUB_API_KEY=
NEWSAPI_KEY=
FMP_API_KEY=

# Optional: EODHD "US Stock Options Data API" add-on, only for the one-off IV history backfill
# (python -m services.iv_backfill). Leave empty: nothing else reads it.
EODHD_API_KEY=
