# Copy to .env (gitignored) and fill in. Placeholders only: the repo is public.

# Postgres password for the `edgeflow` user. Required by docker-compose.yml, which builds the
# containers' DATABASE_URL from it. Keep it URL-safe; generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Only for running the backend outside Docker (compose overrides it inside the containers).
DATABASE_URL=postgresql+asyncpg://edgeflow:change-me@localhost:5432/edgeflow

FINNHUB_API_KEY=
NEWSAPI_KEY=
FMP_API_KEY=
